; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Bajo Sospecha"
config/description="Juego de deducción social y drama corporativo en 2D."
run/main_scene="res://scenes/test_evidence_modal.tscn"
config/features=PackedStringArray("4.3", "Forward Plus")
config/icon="res://icon.svg"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

viewport/hdr_2d=true
environment/defaults/default_environment="res://resources/office_environment.tres"
